{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile containing authentication and role data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User avatar photo URL" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User authorization role" },
        "emailVerified": { "type": "boolean", "description": "Whether user email has been verified" },
        "provider": { "type": "string", "description": "Authentication provider (e.g. password, google)" },
        "favorites": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Array of favorited tool slug identifiers"
        },
        "recentTools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": { "type": "string" },
              "name": { "type": "string" },
              "category": { "type": "string" },
              "lastUsedAt": { "type": "string", "format": "date-time" }
            },
            "required": ["slug", "name", "lastUsedAt"]
          },
          "description": "Bounded array of recently opened tools metadata"
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last profile update timestamp" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last session login timestamp" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "aiTools": {
      "title": "AITool",
      "description": "External AI tool record for discovery, categorization, and pricing guidance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "officialUrl": { "type": "string" },
        "shortDescription": { "type": "string" },
        "fullDescription": { "type": "string" },
        "primaryCategory": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "bestFor": { "type": "array", "items": { "type": "string" } },
        "pricingType": { "type": "string", "enum": ["free", "freemium", "paid", "free-trial", "contact-sales"] },
        "startingPrice": { "type": "string" },
        "currency": { "type": "string" },
        "pricingSummary": { "type": "string" },
        "pricingUrl": { "type": "string" },
        "hasFreePlan": { "type": "boolean" },
        "hasFreeTrial": { "type": "boolean" },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "keyFeatures": { "type": "array", "items": { "type": "string" } },
        "useCases": { "type": "array", "items": { "type": "string" } },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "dateAdded": { "type": "string" },
        "lastVerifiedAt": { "type": "string" },
        "lastPricingVerifiedAt": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" }
      },
      "required": ["id", "slug", "name", "officialUrl", "shortDescription", "primaryCategory", "pricingType", "isPublished"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User document store. Read/write governed by role and UID matching rules."
    },
    "/aiTools/{toolId}": {
      "schema": "aiTools",
      "description": "AI discovery directory collection. Public read for published tools; admin read/write."
    }
  }
}
