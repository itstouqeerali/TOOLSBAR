{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile containing authentication and role data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User avatar photo URL" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User authorization role" },
        "emailVerified": { "type": "boolean", "description": "Whether user email has been verified" },
        "provider": { "type": "string", "description": "Authentication provider (e.g. password, google)" },
        "favorites": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Array of favorited tool slug identifiers"
        },
        "recentTools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": { "type": "string" },
              "name": { "type": "string" },
              "category": { "type": "string" },
              "lastUsedAt": { "type": "string", "format": "date-time" }
            },
            "required": ["slug", "name", "lastUsedAt"]
          },
          "description": "Bounded array of recently opened tools metadata"
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last profile update timestamp" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last session login timestamp" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User document store. Read/write governed by role and UID matching rules."
    }
  }
}
