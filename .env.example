# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Optional canonical production site URL (defaults to https://toolsbar.site)
VITE_SITE_URL="https://toolsbar.site"

# Contact Form & Administrator Notification Settings (Server-side / Cloudflare Pages Functions)
# ADMIN_EMAIL: Recipient email address for Contact Us form submissions (defaults to kingtouqeerali@gmail.com)
ADMIN_EMAIL="kingtouqeerali@gmail.com"

# RESEND_API_KEY: API key from https://resend.com for delivering contact form messages (Recommended)
RESEND_API_KEY=""

# CONTACT_FROM_EMAIL: Verified sender email (e.g. "Toolsbar Contact <support@toolsbar.site>" or "onboarding@resend.dev")
CONTACT_FROM_EMAIL="Toolsbar Contact <onboarding@resend.dev>"

# Alternative Email Providers (Optional fallback if not using Resend)
BREVO_API_KEY=""
SENDGRID_API_KEY=""
CONTACT_WEBHOOK_URL=""

