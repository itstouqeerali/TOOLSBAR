rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdminEmail() {
      return isAuthenticated() && request.auth.token.email == 'kingtouqeerali@gmail.com';
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          isSuperAdminEmail() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        );
    }

    // User profile documents
    match /users/{userId} {
      // Allow user to read their own profile, or admins to read all user profiles
      allow read: if isOwner(userId) || isAdmin();

      // Allow users to create their own record upon registration
      // If email is the designated initial admin, role can be 'admin'; otherwise role MUST be 'user'
      allow create: if isOwner(userId) && (
        (request.resource.data.role == 'user') ||
        (isSuperAdminEmail() && request.resource.data.role == 'admin')
      );

      // Allow users to update their profile (e.g. displayName, updatedAt) but prevent modifying role unless admin
      // The super-admin account cannot be demoted under any circumstances
      allow update: if (
        (resource.data.email != 'kingtouqeerali@gmail.com' || request.resource.data.role == 'admin') &&
        (
          (isOwner(userId) && request.resource.data.role == resource.data.role) ||
          isAdmin()
        )
      );

      // Deletion only by admin, super-admin cannot be deleted
      allow delete: if isAdmin() && resource.data.email != 'kingtouqeerali@gmail.com';
    }
  }
}

